# Shopify shop domain (not secret)
NEXT_PUBLIC_SHOPIFY_DOMAIN=lil-freak.myshopify.com
# PUBLIC Storefront access token only (designed to be visible in the browser).
# NEVER put a private Storefront token, Admin API token or any secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-07
# Your live site address (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
